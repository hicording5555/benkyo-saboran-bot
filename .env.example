LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
CRON_SECRET=change_me_to_a_long_random_string
PORT=8000
TZ=Asia/Tokyo
# Render 無料枠は data/users.json をスリープで消す。非公開 JSON の URL と
# Security-key をここではなくホストの環境変数に置く。
# USERS_STORE_URL=https://extendsclass.com/api/json-storage/bin/<id>
# USERS_STORE_SECRET=long-random-string
# 任意。起動時に一度マージするだけ（書き戻しには使わない）。
# USERS_JSON={}
